<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="MapControl" targetNamespace="https://github.com/AlexanderKuzikov/MapControl" exporter="Camunda Modeler" exporterVersion="5.50.1">
  <bpmn:process id="P_Launch" name="Запуск MapControl" isExecutable="false">
    <bpmn:startEvent id="l_start" name="start.vbs">
      <bpmn:outgoing>l_f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="l_check" name="GET /api/config — свой сервер уже запущен?">
      <bpmn:incoming>l_f1</bpmn:incoming>
      <bpmn:outgoing>l_f2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="l_gw" name="Свой сервер отвечает?">
      <bpmn:incoming>l_f2</bpmn:incoming>
      <bpmn:outgoing>l_f_yes</bpmn:outgoing>
      <bpmn:outgoing>l_f_no</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="l_open1" name="Открыть браузер (тот же порт)">
      <bpmn:incoming>l_f_yes</bpmn:incoming>
      <bpmn:outgoing>l_f3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="l_end1" name="Готово">
      <bpmn:incoming>l_f3</bpmn:incoming>
      <bpmn:incoming>l_f6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="l_port" name="Найти свободный порт 5179–5279">
      <bpmn:incoming>l_f_no</bpmn:incoming>
      <bpmn:outgoing>l_f4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="l_spawn" name="node server.js, лог server.log, PID-файл">
      <bpmn:incoming>l_f4</bpmn:incoming>
      <bpmn:outgoing>l_f5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="l_wait" name="Ждать /api/config до 30 с">
      <bpmn:incoming>l_f5</bpmn:incoming>
      <bpmn:outgoing>l_f7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="l_gw2" name="Сервер готов?">
      <bpmn:incoming>l_f7</bpmn:incoming>
      <bpmn:outgoing>l_f8</bpmn:outgoing>
      <bpmn:outgoing>l_f9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="l_open2" name="Открыть браузер (новый порт)">
      <bpmn:incoming>l_f8</bpmn:incoming>
      <bpmn:outgoing>l_f6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="l_kill" name="Убить процесс, exit(1)">
      <bpmn:incoming>l_f9</bpmn:incoming>
      <bpmn:outgoing>l_f10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="l_end_err" name="Ошибка старта">
      <bpmn:incoming>l_f10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="l_f1" sourceRef="l_start" targetRef="l_check" />
    <bpmn:sequenceFlow id="l_f2" sourceRef="l_check" targetRef="l_gw" />
    <bpmn:sequenceFlow id="l_f_yes" name="да" sourceRef="l_gw" targetRef="l_open1" />
    <bpmn:sequenceFlow id="l_f_no" name="нет" sourceRef="l_gw" targetRef="l_port" />
    <bpmn:sequenceFlow id="l_f3" sourceRef="l_open1" targetRef="l_end1" />
    <bpmn:sequenceFlow id="l_f4" sourceRef="l_port" targetRef="l_spawn" />
    <bpmn:sequenceFlow id="l_f5" sourceRef="l_spawn" targetRef="l_wait" />
    <bpmn:sequenceFlow id="l_f7" sourceRef="l_wait" targetRef="l_gw2" />
    <bpmn:sequenceFlow id="l_f8" name="да" sourceRef="l_gw2" targetRef="l_open2" />
    <bpmn:sequenceFlow id="l_f9" name="нет" sourceRef="l_gw2" targetRef="l_kill" />
    <bpmn:sequenceFlow id="l_f6" sourceRef="l_open2" targetRef="l_end1" />
    <bpmn:sequenceFlow id="l_f10" sourceRef="l_kill" targetRef="l_end_err" />
  </bpmn:process>
  <bpmn:process id="P_Submission" name="Заявка на объект" isExecutable="false">
    <bpmn:laneSet id="ls1">
      <bpmn:lane id="lane_srv" name="Сервер (Node + внешние сервисы)">
        <bpmn:flowNodeRef>s_created</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s_images</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s_llmreq</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s_llm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s_resp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s_apply_srv</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s_submit_srv</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s_gw_full</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s_end_stop</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s_shutdown</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s_email</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_op" name="Оператор (браузер)">
        <bpmn:flowNodeRef>s_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s_fill</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s_save</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s_upload</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s_check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s_apply</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s_submit_btn</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s_end</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s_exit</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s_start" name="Форма открыта">
      <bpmn:outgoing>s_f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="s_fill" name="Заполнить: заголовок, описание, координаты (карта/вручную)">
      <bpmn:incoming>s_f1</bpmn:incoming>
      <bpmn:outgoing>s_f2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="s_save" name="Сохранить черновик">
      <bpmn:incoming>s_f2</bpmn:incoming>
      <bpmn:outgoing>s_f3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="s_created" name="POST /draft, /update → draft/meta.json (атомарно)">
      <bpmn:incoming>s_f3</bpmn:incoming>
      <bpmn:outgoing>s_f4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="s_upload" name="Загрузить фото">
      <bpmn:incoming>s_f4</bpmn:incoming>
      <bpmn:outgoing>s_f5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="s_images" name="EXIF GPS → sharp WebP → meta.images + gps">
      <bpmn:incoming>s_f5</bpmn:incoming>
      <bpmn:outgoing>s_f6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="s_check" name="Проверить (LLM)">
      <bpmn:incoming>s_f6</bpmn:incoming>
      <bpmn:outgoing>s_f7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="s_llmreq" name="POST /llm/check-text: zod → запрос провайдеру">
      <bpmn:incoming>s_f7</bpmn:incoming>
      <bpmn:outgoing>s_f8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:serviceTask id="s_llm" name="LLM: текст, категория (9), сваи, warnings" implementation="##WebService">
      <bpmn:incoming>s_f8</bpmn:incoming>
      <bpmn:outgoing>s_f9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:task id="s_resp" name="Проверка JSON-ответа → diff, категория, сваи">
      <bpmn:incoming>s_f9</bpmn:incoming>
      <bpmn:outgoing>s_f10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="s_apply" name="Принять правки AI / оставить своё">
      <bpmn:incoming>s_f10</bpmn:incoming>
      <bpmn:incoming>s_f_bad</bpmn:incoming>
      <bpmn:outgoing>s_f11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="s_apply_srv" name="POST apply-llm → finals + llm-мета в meta">
      <bpmn:incoming>s_f11</bpmn:incoming>
      <bpmn:outgoing>s_f12</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="s_submit_btn" name="Отправить">
      <bpmn:incoming>s_f12</bpmn:incoming>
      <bpmn:outgoing>s_f13</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="s_submit_srv" name="POST /submit: полнота → pending + копия фото">
      <bpmn:incoming>s_f13</bpmn:incoming>
      <bpmn:outgoing>s_f14</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="s_gw_full" name="Всё заполнено?">
      <bpmn:incoming>s_f14</bpmn:incoming>
      <bpmn:outgoing>s_f_ok</bpmn:outgoing>
      <bpmn:outgoing>s_f_bad</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="s_email" name="SMTP админу: JSON + WebP (только meta.images)" implementation="##WebService">
      <bpmn:incoming>s_f_ok</bpmn:incoming>
      <bpmn:outgoing>Flow_1cvb97d</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:task id="s_exit" name="Выход (диалог)">
      <bpmn:outgoing>s_f16</bpmn:outgoing>
      <bpmn:outgoing>s_f17</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="s_shutdown" name="POST /shutdown → exit(0)">
      <bpmn:incoming>s_f16</bpmn:incoming>
      <bpmn:incoming>Flow_1cvb97d</bpmn:incoming>
      <bpmn:outgoing>s_f19</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="s_end" name="Окно можно закрыть">
      <bpmn:incoming>s_f17</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="s_end_stop" name="Сервер остановлен">
      <bpmn:incoming>s_f19</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="s_f1" sourceRef="s_start" targetRef="s_fill" />
    <bpmn:sequenceFlow id="s_f2" sourceRef="s_fill" targetRef="s_save" />
    <bpmn:sequenceFlow id="s_f3" sourceRef="s_save" targetRef="s_created" />
    <bpmn:sequenceFlow id="s_f4" sourceRef="s_created" targetRef="s_upload" />
    <bpmn:sequenceFlow id="s_f5" sourceRef="s_upload" targetRef="s_images" />
    <bpmn:sequenceFlow id="s_f6" sourceRef="s_images" targetRef="s_check" />
    <bpmn:sequenceFlow id="s_f7" sourceRef="s_check" targetRef="s_llmreq" />
    <bpmn:sequenceFlow id="s_f8" sourceRef="s_llmreq" targetRef="s_llm" />
    <bpmn:sequenceFlow id="s_f9" sourceRef="s_llm" targetRef="s_resp" />
    <bpmn:sequenceFlow id="s_f10" sourceRef="s_resp" targetRef="s_apply" />
    <bpmn:sequenceFlow id="s_f11" sourceRef="s_apply" targetRef="s_apply_srv" />
    <bpmn:sequenceFlow id="s_f12" sourceRef="s_apply_srv" targetRef="s_submit_btn" />
    <bpmn:sequenceFlow id="s_f13" sourceRef="s_submit_btn" targetRef="s_submit_srv" />
    <bpmn:sequenceFlow id="s_f14" sourceRef="s_submit_srv" targetRef="s_gw_full" />
    <bpmn:sequenceFlow id="s_f_ok" name="да" sourceRef="s_gw_full" targetRef="s_email" />
    <bpmn:sequenceFlow id="s_f_bad" name="нет" sourceRef="s_gw_full" targetRef="s_apply" />
    <bpmn:sequenceFlow id="s_f16" sourceRef="s_exit" targetRef="s_shutdown" />
    <bpmn:sequenceFlow id="s_f17" sourceRef="s_exit" targetRef="s_end" />
    <bpmn:sequenceFlow id="s_f19" sourceRef="s_shutdown" targetRef="s_end_stop" />
    <bpmn:sequenceFlow id="Flow_1cvb97d" sourceRef="s_email" targetRef="s_shutdown" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="D1" name="MapControl">
    <bpmndi:BPMNPlane id="Plane2" bpmnElement="P_Submission">
      <bpmndi:BPMNShape id="d_lane_op" bpmnElement="lane_op" isHorizontal="true">
